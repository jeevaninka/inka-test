# =============================================================================
# InkaTest (InkaQA) — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# In AWS Amplify Console, configure the Production variables under App Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & LOGGING
# -----------------------------------------------------------------------------
# Options: development | staging | production
# Note: When APP_ENV=production (and NODE_ENV=production), email/password login is disabled and only Google OAuth is allowed.
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Options: debug | info | warn | error | silent (defaults to "info" in production, "debug" in development)
LOG_LEVEL="debug"

# -----------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 14+)
# -----------------------------------------------------------------------------
# Include connection_limit and pool_timeout for serverless/SSR environments (e.g. AWS Amplify + RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inkatest?schema=public&connection_limit=3&pool_timeout=20"
# Serverless default: 3 connections per instance (behind pgBouncer / RDS Proxy).
# Raise only if you run a single long-lived server. Never use one URL for both.
DATABASE_CONNECTION_LIMIT="3"
# Direct (non-pooled) connection used ONLY by `prisma migrate deploy` in CI/CD.
# Required by .github/workflows/deploy-migrations.yml.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inkatest?schema=public"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth.js + AES-256-GCM Encryption)
# -----------------------------------------------------------------------------
# Canonical base URL of your application (no trailing slash)
NEXTAUTH_URL="http://localhost:3002"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-byte-base64-secret-from-openssl"

# Used by src/lib/crypto.ts to encrypt third-party API keys & webhook secrets in the DB (AES-256-GCM).
# Generate with: openssl rand -base64 32 (falls back to NEXTAUTH_SECRET if omitted, but separate key recommended in prod)
ENCRYPTION_KEY="replace-with-32-byte-base64-encryption-key"

# Google OAuth 2.0 Credentials (Google Cloud Console)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -----------------------------------------------------------------------------
# 4. AI INTELLIGENCE (Google Gemini)
# -----------------------------------------------------------------------------
# Used by src/lib/ai/client.ts (Model: gemini-2.5-flash)
GEMINI_API_KEY="your-google-gemini-api-key"

# AI usage guardrails
AI_DAILY_QUOTA="50"
AI_MONTHLY_QUOTA="500"
AI_INPUT_CAP="8000"
# Hard per-request deadline for provider calls. Amplify SSR requests time out at
# ~30s, so keep this below that and move bulk work to a background job.
AI_REQUEST_TIMEOUT_MS="25000"

# -----------------------------------------------------------------------------
# 4b. RATE LIMITING & IMPORT GUARDRAILS (in-memory, per instance)
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_15MIN="8"
AI_RATE_LIMIT_PER_10MIN="20"
IMPORT_RATE_LIMIT_PER_10MIN="5"
IMPORT_MAX_ROWS="500"

# -----------------------------------------------------------------------------
# 5. EMAIL SERVICE (AWS SES for Production / SMTP for Local Dev)
# -----------------------------------------------------------------------------
# Provider selector: "ses" (production) | "smtp" (local development)
EMAIL_PROVIDER="smtp"

# Default sender email address
MAIL_FROM="noreply@yourdomain.com"

# --- Production: AWS SES ---
# Note: Use SES_REGION and SES_FROM_EMAIL in AWS Amplify Console because Amplify blocks custom variables starting with "AWS_".
# Legacy aliases AWS_SES_REGION and AWS_SES_FROM_EMAIL are also supported.
SES_REGION="ap-south-1"
SES_FROM_EMAIL="noreply@yourdomain.com"

# --- Local Development: SMTP (e.g. Mailpit / Mailhog / Custom SMTP) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# -----------------------------------------------------------------------------
# 6. FILE STORAGE (AWS S3 for Production / S3-Compatible for Local Dev)
# -----------------------------------------------------------------------------
# --- Production: AWS S3 ---
# Uses AWS Amplify / IAM Execution Role credentials automatically in production.
S3_REGION="ap-south-1"
S3_BUCKET_NAME="inkatest-attachments-prod"

# --- Local Development Only: MinIO / LocalStack ---
# IMPORTANT: Leave S3_ENDPOINT_LOCAL empty or unset in production so the app uses AWS S3.
S3_ENDPOINT_LOCAL="http://localhost:9000"
S3_REGION_LOCAL="us-east-1"
S3_ACCESS_KEY_ID_LOCAL="minioadmin"
S3_ACCESS_KEY_LOCAL="minioadmin"
S3_BUCKET_NAME_LOCAL="inkatest-local"

# -----------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS & FALLBACKS
# -----------------------------------------------------------------------------
# Fallback Slack Incoming Webhook URL if not configured at workspace/project level
SLACK_WEBHOOK_URL=""

# Optional explicit AWS credentials (ONLY for non-AWS hosting where IAM Roles are unavailable; do NOT set in Amplify Console)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# 8. EXECUTION SCHEDULER
# -----------------------------------------------------------------------------
# Shared secret for POST/GET /api/v1/internal/execution/tick (external cron).
# Leave unset when relying on the in-process scheduler (src/instrumentation.ts);
# the endpoint returns 401/503 without a configured secret.
EXECUTION_TICK_SECRET=""
